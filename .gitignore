# ---- data: never commit (raw downloads and derived objects are large / licensed) ----
data/raw/*
data/processed/*
data/annotation/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/annotation/.gitkeep

# ---- outputs: regenerated by run_all.R ----
results/
results_demo/
logs/

# ---- scratch / debugging scripts kept locally, not part of the released pipeline ----
tools/tmp_*
tools/_*
tools/debug_*
tools/diag_*
tools/probe_*
tools/pick_mirror_install.R
tools/install_stage.R
tools/_cfgtest.R
tools/check_*
tools/show_*
tools/dlr.R
tools/downloader.R
tools/resume_dl.R
tools/segdl.R
tools/stream_mtx.R
tools/build_lincs_panel.R
tools/build_lincs_panel2.R
tools/build_lincs_panel3.R
tools/cmap_pipeline_bucket.R
tools/cmap_pipeline_full.R
tools/cmap_pipeline_v4.R
tools/make_deconv_box.R
tools/make_small2_macaque.R
tools/rerun_scdeg_tm_full.R
tools/write_sc_counts.R
tools/fill_wordcount.R
tools/draw_med_forest.R
tools/mr_forest.R
tools/inspect_mr_all.R
tools/verify_iop.R
_check_*
_debug_*
_extract_*
_preview_*
_edits_raw.txt
logs_frozen/
results_frozen/

# ---- vendored third-party sources (re-cloned during environment setup, not redistributed) ----
tools/ldsc/
tools/*_src/
tools/plink-ng/
tools/CellChat_src/
tools/monocle3_src/

# ---- R / OS cruft ----
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rcheck/
*.tar.gz
Thumbs.db
.DS_Store
desktop.ini

# ---- package index snapshots (re-downloadable, setup-time only) ----
downloads/

# 外部工具二进制（plink/plink2/SMR 等，合计约 80 MB，脚本会自行下载）
tools/bin/

# 下载下来的原始数据/注释包，体积大且可重新获取
downloads/
