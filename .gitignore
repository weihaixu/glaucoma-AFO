# ---- data: never commit (raw downloads and derived objects are large / licensed) ----
data/raw/*
data/processed/*
data/annotation/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/annotation/.gitkeep

# ---- outputs: regenerated by run_all.R ----
results/
results_demo/
logs/

# ---- scratch / debugging scripts kept locally, not part of the released pipeline ----
tools/tmp_*
tools/_*
tools/debug_*
tools/diag_*
tools/probe_*
tools/pick_mirror_install.R
tools/install_stage.R
tools/_cfgtest.R

# ---- R / OS cruft ----
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rcheck/
*.tar.gz
Thumbs.db
.DS_Store
desktop.ini
